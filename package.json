{
  "name": "slop-mop",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:vite": "vite",
    "build": "tauri build",
    "install-mac-app": "bash scripts/install-mac-app.sh",
    "build:frontend": "tsc -b && vite build",
    "preview": "vite preview",
    "check": "biome check .",
    "check:fix": "biome check --fix .",
    "woke2:check": "node tools/woke2-check.js",
    "typecheck": "tsc -b",
    "test": "pnpm test:ts && pnpm test:rs",
    "test:ts": "vitest run",
    "test:rs": "cargo test --manifest-path src-tauri/Cargo.toml --lib",
    "test:watch": "vitest",
    "tauri": "tauri",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "^8.0.3",
    "lucide-react": "^0.577.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "shadcn": "^4.0.5",
    "shiki": "^4.0.2",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.6",
    "@tailwindcss/vite": "^4.2.1",
    "@tauri-apps/cli": "^2",
    "@types/node": "^25.4.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "esbuild": "^0.27.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.3",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,json,css}": "biome check --fix --no-errors-on-unmatched"
  }
}
