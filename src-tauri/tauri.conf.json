{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claude Crèche",
  "version": "0.0.1",
  "identifier": "com.claude-creche.app",
  "build": {
    "beforeBuildCommand": "pnpm build",
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Claude Crèche",
        "width": 1200,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  }
}
