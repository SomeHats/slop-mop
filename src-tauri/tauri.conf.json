{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claude Crèche",
  "version": "0.0.1",
  "identifier": "com.claude-creche.app",
  "build": {
    "beforeBuildCommand": "pnpm build",
    "beforeDevCommand": "pnpm dev:vite",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "picker",
        "title": "Claude Crèche",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "width": 600,
        "height": 500,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  }
}
