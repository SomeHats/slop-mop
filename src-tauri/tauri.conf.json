{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Slop Mop",
  "version": "0.0.1",
  "identifier": "com.slop-mop.desktop",
  "build": {
    "beforeBuildCommand": "pnpm build:frontend",
    "beforeDevCommand": "pnpm dev:vite",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"]
  },
  "app": {
    "windows": [
      {
        "label": "picker",
        "title": "Slop Mop",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 12, "y": 16 },
        "width": 600,
        "height": 500,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  }
}
